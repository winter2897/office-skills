{
  "layout": "simple",
  "page": "a4",
  "font": "Arial",
  "body_pt": 11,
  "lang": "en",
  "document_type": "Test Document",
  "title": "{{TITLE}}",
  "object": "{{UNIT_UNDER_TEST}}",
  "doc_no": "{{DOC_NO}}",
  "project": "{{PROJECT}}",
  "version": "{{VERSION}}",
  "date": "{{DATE}}",
  "prepared_by": "{{AUTHOR}}",
  "tested_by": "{{TESTED_BY}}",
  "classification": "{{CLASSIFICATION}}",
  "revisions": [["{{VERSION}}", "{{DATE}}", "{{CHANGE_DESCRIPTION}}", "{{CHANGE_AUTHOR}}"]],
  "sections": [
    {
      "heading": "Purpose of Testing",
      "blocks": [
        {"type": "para", "text": "{{PURPOSE – one or two sentences: what is being qualified and what question the test answers.}}"},
        {"type": "para", "text": "{{DELIVERABLE – one sentence: the limit, procedure or go/no-go this test produces.}}"}
      ]
    },
    {
      "heading": "System Configuration",
      "blocks": [
        {"type": "kv", "label_width": 3000, "rows": [
          ["{{PART}}", "{{PART_NUMBER}}"],
          ["{{HARDWARE_REV}}", "{{REVISION}}"],
          ["{{FIRMWARE}}", "{{VERSION}}"],
          ["{{RIG}}", "{{RIG_DESCRIPTION}}"],
          ["{{INSTRUMENTATION}}", "{{INSTRUMENTS_AND_RANGES}}"]
        ]}
      ]
    },
    {
      "heading": "Items to be Tested / Not Tested",
      "blocks": [
        {"type": "table",
         "caption": "{{SCOPE_CAPTION}}",
         "header": ["Item to Test", "Test Overview", "Responsibility"],
         "widths": [2600, 5038, 2000],
         "rows": [
           ["{{ITEM_1}}", "{{OVERVIEW_1}}", "{{OWNER_1}}"],
           ["{{ITEM_2}}", "{{OVERVIEW_2}}", "{{OWNER_2}}"],
           ["{{ITEM_3}}", "{{OVERVIEW_3}}", "{{OWNER_3}}"]
         ]},
        {"type": "para", "text": "Not tested: {{OUT_OF_SCOPE}} – {{WHERE_IT_IS_COVERED_INSTEAD}}."}
      ]
    },
    {
      "heading": "Test Approach",
      "blocks": [
        {"type": "para", "text": "Measured throughout:"},
        {"type": "bullets", "items": [
          "{{MEASURED_QUANTITY_1}}",
          "{{MEASURED_QUANTITY_2}}",
          "{{MEASURED_QUANTITY_3}}"
        ]},
        {"type": "table",
         "caption": "{{METHOD_CAPTION}}",
         "header": ["Name", "Purpose", "Definition"],
         "widths": [2000, 4638, 3000],
         "rows": [
           ["{{METHOD_1}}", "{{METHOD_PURPOSE_1}}", "{{METHOD_DEFINITION_1}}"],
           ["{{METHOD_2}}", "{{METHOD_PURPOSE_2}}", "{{METHOD_DEFINITION_2}}"]
         ]},
        {"type": "para", "text": "{{CONDITIONS – ambient, supply, duration. One line.}}"}
      ]
    },
    {
      "heading": "Test PASS / FAIL Criteria",
      "blocks": [
        {"type": "para", "text": "{{CRITERIA – normally one line: itemised per test in Table 1 and repeated with the outcome in the results summary.}}"}
      ]
    },
    {
      "heading": "Test Results",
      "blocks": [],
      "sections": [
        {
          "heading": "{{TEST_NAME_1}}",
          "blocks": [
            {"type": "para", "text": "{{RESULT_1 – the measurement and what it means. Numbers carry units and conditions.}}"},
            {"type": "figure", "placeholder": "[ {{INSERT_PLOT}} ]", "caption": "{{FIGURE_CAPTION_1}}"}
          ]
        },
        {
          "heading": "{{TEST_NAME_2}}",
          "blocks": [
            {"type": "para", "text": "{{RESULT_2}}"}
          ]
        },
        {
          "heading": "{{FAILURE_NAME – delete this subsection if nothing failed}}",
          "blocks": [
            {"type": "para", "text": "{{WHAT_FAILED – the event and the measurement that shows it.}}"},
            {"type": "para", "text": "Root cause: {{ROOT_CAUSE}}."},
            {"type": "para", "text": "Action: {{FIX_OR_NEXT_STEP}}."}
          ]
        },
        {
          "heading": "Summary",
          "blocks": [
            {"type": "table",
             "caption": "{{SUMMARY_CAPTION}}",
             "header": ["Test Name", "Test Description", "Pass Criteria", "Result"],
             "widths": [1900, 3538, 2200, 2000],
             "rows": [
               ["{{TEST_NAME_1}}", "{{DESCRIPTION_1}}", "{{CRITERIA_1}}", "{{PASS_FAIL_OR_NOT_TESTED_1}}"],
               ["{{TEST_NAME_2}}", "{{DESCRIPTION_2}}", "{{CRITERIA_2}}", "{{PASS_FAIL_OR_NOT_TESTED_2}}"],
               ["{{TEST_NAME_3}}", "{{DESCRIPTION_3}}", "{{CRITERIA_3}}", "{{PASS_FAIL_OR_NOT_TESTED_3}}"]
             ]}
          ]
        }
      ]
    },
    {
      "heading": "Conclusions/Recommendations",
      "blocks": [
        {"type": "para", "text": "{{VERDICT – qualified, qualified with limits, or not qualified. One sentence, first.}}"},
        {"type": "bullets", "items": [
          "{{ACTION_1}}",
          "{{ACTION_2}}",
          "{{OPEN_ITEM – what is unresolved and who owns it.}}"
        ]}
      ]
    }
  ]
}
